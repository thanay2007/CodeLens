# Local source inspection works without service keys. Production requires Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional fallback for documentation and chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PINECONE_API_KEY=
PINECONE_INDEX=codelens
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
# Private per-user history on Supabase. Run the migration and use its codelens_app role.
SUPABASE_DATABASE_URL=
# Server-only 32-byte key in hex. Keep it outside Supabase and back it up securely.
CODELENS_HISTORY_KEY=
# Existing PostgreSQL snapshot storage when SUPABASE_DATABASE_URL is unset.
DATABASE_URL=
# Optional absolute directory for a persistent SQLite volume on a single Node server.
CODELENS_DATA_DIR=
# Optional: increases GitHub's public API rate limit. Server only.
GITHUB_TOKEN=
