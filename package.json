{
  "name": "codelens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "smoke": "node scripts/smoke-live.mjs",
    "format": "prettier --write src tests scripts *.md *.json *.ts *.mjs .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts *.md *.json *.ts *.mjs .github/workflows/*.yml"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@langchain/core": "^1.3.5",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/textsplitters": "^1.0.2",
    "@pinecone-database/pinecone": "^5.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.70.0",
    "mermaid": "^12.3.0",
    "next": "^16.4.5",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
